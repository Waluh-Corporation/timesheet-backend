  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Clean Architecture",
      "items": [
        "Gin REST API controllers decouple HTTP routing from business logic using DTO request validation and response envelopes",
        "Authentication via Argon2id password hashing, JWT bearer tokens, and WebAuthn (FIDO2 passkeys) with RBAC authorization",
        "Repository pattern encapsulates GORM data access with context cancellation propagation and strict user IDOR boundaries"
      ]
    },
    {
      "dot": "emerald",
      "title": "Asynchronous Timesheet Engine",
      "items": [
        "Multi-company Excel workbook builders (MII, NTT, SDD, Adidata) powered by Excelize v2 and PDF conversion",
        "Redis 7 distributed job queue with Asynq worker pools preventing HTTP request timeouts on large data exports",
        "S3-compatible object storage with time-bound cryptographic magic download tokens and automatic lifecycle pruning"
      ]
    },
    {
      "dot": "rose",
      "title": "Reliability & Background Automation",
      "items": [
        "Robfig cron scheduler operating in Asia/Jakarta timezone (WIB) firing daily reminders at 17:00 WIB for unsubmitted activities",
        "WebPush notifications dispatched using RFC 8291/8292 VAPID encryption to desktop and mobile browser clients",
        "Automated DBA housekeeping purging expired refresh tokens, password reset nonces, and stale storage objects"
      ]
    }
  ]
