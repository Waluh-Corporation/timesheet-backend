      "dot": "cyan",
      "title": "Ingress & Authentication",
      "items": [
        "Gin REST API protected by Argon2id password hashing and WebAuthn (FIDO2 passkeys)",
        "Role-Based Access Control (RBAC) with user and admin access boundaries",
        "Consistent JSON response envelopes and sanitized route parameter validation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Business Engine & Storage",
      "items": [
