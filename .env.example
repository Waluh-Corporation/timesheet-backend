# Backend configuration (copy to .env or export in your environment).

# HTTP & Application
PORT=8080
GIN_MODE=debug
APP_NAME=Timesheet Portal
# Base URL of frontend used for email links (setup & password-reset)
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (e.g. "http://localhost:3000,https://timesheet-frontend-dev.fafr.my.id" or "*").
# When empty, falls back to FRONTEND_URL, WEBAUTHN_RP_ORIGIN, and localhost (in non-release mode).
CORS_ALLOWED_ORIGINS=
ADMIN_EMAIL=admin@timesheet.local

# PostgreSQL
DATABASE_URL=host=localhost user=timesheet password=timesheet dbname=timesheet port=5432 sslmode=disable TimeZone=Asia/Jakarta

# Database Connection Pooling (dynamic pool configuration)
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_TIME_MINUTES=15

# Database migrations: set to true (or run with -migrate / -migrate-only flag) to run migrations.
# Defaults to false so "go run ." starts without modifying schema or running DDL.
RUN_MIGRATIONS=false

# Authentication & Dual-Token Lifetimes
# JWT session tokens. REQUIRED in production (GIN_MODE=release): the server
# refuses to boot if this is empty or a known-weak placeholder. Generate one
# with e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRY_HOURS=24
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=60
RESET_PASSWORD_COOLDOWN_SECONDS=60

# Rate Limiting (public auth endpoints: login, forgot-password, reset-password, passkey)
# Automatically disabled in GIN_MODE=debug. In release mode, defaults to enabled (10 req / 60s).
# Set RATE_LIMIT_ENABLED=false or RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=0

# WebAuthn relying party (origin(s) must match the frontend origin).
# WEBAUTHN_RP_ORIGIN accepts a comma-separated list to allow passkeys across
# multiple domains, e.g. "https://app.example.com,https://timesheet.example.org".
WEBAUTHN_RP_NAME=Timesheet Portal
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Timesheet Portal <no-reply@timesheet.local>

# Web Push VAPID keys. Leave blank to auto-generate at boot (logged to stdout);
# pin a stable pair in production so subscriptions survive restarts.
# Generate VAPID keys using: https://vapidkeys.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Reminder scheduler timezone (WIB) and cron expressions
SCHEDULER_TZ=Asia/Jakarta
# Daily timesheet reminder cron (standard 5-part cron syntax: minute hour dom month dow)
SCHEDULER_REMINDER_CRON=0 17 * * *
# Housekeeping cron to purge stale password reset tokens
SCHEDULER_CLEANUP_CRON=0 2 * * *

# Bootstrap admin (created once when the users table is empty). Leave the
# password blank to have a strong random one generated and printed to the logs
# on first boot; set it to choose your own.
BOOTSTRAP_ADMIN_EMAIL=admin@timesheet.local
BOOTSTRAP_ADMIN_USERNAME=admin
# Leave blank to have a strong NIST SP 800-63B-compliant password generated and
# logged once on first boot. If set, it must satisfy the same policy (>= 8 chars,
BOOTSTRAP_ADMIN_PASSWORD=

# Redis Task Queue
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# S3-Compatible Object Storage (AWS S3, MinIO, Cloudflare R2, Wasabi)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=timesheets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=false
S3_RETENTION_DAYS=7

# Mailer Worker Pool & Rate Limiter (SES-ready)
MAILER_RATE_LIMIT=10.0
MAILER_WORKER_COUNT=5

# Excel Concurrency Limit (CPU & RAM protection)
EXCEL_MAX_CONCURRENT_JOBS=10
