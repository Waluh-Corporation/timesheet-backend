# ==============================================================================
# Timesheet Generator - Environment Configuration Template
# Salin file ini ke `.env` dan sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Port & Network
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=timesheet
POSTGRES_PASSWORD=timesheet
POSTGRES_DB=timesheet
DATABASE_URL=host=postgres user=timesheet password=timesheet dbname=timesheet port=5432 sslmode=disable TimeZone=Asia/Jakarta

# ------------------------------------------------------------------------------
# 3. Application & Security
# ------------------------------------------------------------------------------
GIN_MODE=release
# WAJIB diisi saat production (GIN_MODE=release). Buat token acak (misal: `openssl rand -hex 32`)
JWT_SECRET=supersecret-random-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
SCHEDULER_TZ=Asia/Jakarta

# ------------------------------------------------------------------------------
# 4. URLs & WebAuthn (Passkey)
# ------------------------------------------------------------------------------
# URL yang diakses oleh browser pengguna
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebAuthn relying party (origin harus sesuai dengan URL frontend)
WEBAUTHN_RP_NAME="Timesheet Portal"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Email & SMTP
# ------------------------------------------------------------------------------
# Untuk lokal development gunakan host 'mailpit' dan port 1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Timesheet Portal <no-reply@timesheet.local>

# ------------------------------------------------------------------------------
# 6. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Biarkan kosong saat development awal (akan di-generate otomatis saat boot),
# atau set pasangan VAPID key tetap untuk production:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@timesheet.local

# ------------------------------------------------------------------------------
# 7. Initial Bootstrap Admin Account
# ------------------------------------------------------------------------------
# Dibuat otomatis saat tabel users pertama kali kosong
BOOTSTRAP_ADMIN_EMAIL=admin@timesheet.local
BOOTSTRAP_ADMIN_USERNAME=admin
# Jika dikosongkan, password acak kuat akan di-generate dan dicetak ke log backend
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 8. Container Images (GitHub Container Registry - GHCR)
# ------------------------------------------------------------------------------
# Backend:  https://github.com/users/naufalzaid17/packages/container/package/timesheet-generator-backend
# Frontend: https://github.com/users/naufalzaid17/packages/container/package/timesheet-generator-frontend
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/naufalzaid17/timesheet-generator-backend:latest
FRONTEND_IMAGE=ghcr.io/naufalzaid17/timesheet-generator-frontend:latest
